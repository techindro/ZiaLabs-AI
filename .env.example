# ============================================
# ZiaLabs AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env
# ============================================

# ── Server Configuration ──
PORT=3000
NODE_ENV=development

# ── Authentication ──
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── Google Gemini AI ──
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional: Semantic Scholar API ──
# Free but rate-limited without key
# Get key at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ── Optional: IEEE Xplore API ──
# Register at: https://developer.ieee.org/
IEEE_API_KEY=
