{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/sql.js/dist/**,zialabs.db"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|css/|js/|img/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
